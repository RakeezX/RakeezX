        "Review Home empty, populated, and Today Focus states on mobile and desktop."
      ],
      "strict": false
    },
    "schedule": {
      "unit": [
        "tests/schedule-mobile-today.test.mjs",
        "tests/sessions-generator.test.mjs",
        "tests/timing-sync.test.mjs"
      ],
      "browser": [
        "tests/schedule-mobile-today.e2e.mjs",
        "tests/schedule-residual.e2e.mjs",
        "tests/timing-effective-ux.e2e.mjs"
      ],
      "review": [
