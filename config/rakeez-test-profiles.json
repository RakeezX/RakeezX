{
  "version": 1,
  "build_command": "npx vite build",
  "diff_check_command": "git diff --check",
  "profiles": {
    "teacher-center": {
      "unit": [],
      "browser": [
        "tests/teacher-hub-auth.e2e.mjs",
        "tests/sync-reconnect.e2e.mjs"
      ],
      "review": [
        "Open the Teacher Control Center and review account, academic-context, and sync states.",
